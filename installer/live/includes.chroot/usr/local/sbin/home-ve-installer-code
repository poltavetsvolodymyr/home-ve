#!/bin/sh
# The code the installer's page asks for (one per boot, in /run), and the screen's text with it and the address:
# whoever reads it is in front of the machine. agetty fills in \4 (the address) and redraws when it changes.
set -eu
dir=/run/home-ve-installer
code=$dir/code
mkdir -p "$dir"
chmod 0700 "$dir"
if [ ! -s "$code" ]; then
  c=$(tr -dc 'ABCDEFGHJKMNPQRSTUVWXYZ23456789' </dev/urandom | head -c 8)
  printf '%s-%s\n' "$(printf %s "$c" | cut -c1-4)" "$(printf %s "$c" | cut -c5-8)" >"$code"
fi
mkdir -p /etc/issue.d
cat >/etc/issue.d/home-ve-installer.issue <<EOT

  home-ve installer

  On a phone or a computer in the same network, open   https://\4/
  and enter the code   $(cat "$code")

  No address above: no network yet. Plug a cable in, the address appears by itself.
  Alt+F2: a root shell, to do things by hand.

EOT
