#!/bin/sh
# Inside the image's system while live-build makes it: the services the installer needs at boot.
set -e
systemctl enable systemd-networkd systemd-resolved home-ve-installer.service
# the screen's user: its shell shows the page (home-ve-kiosk); no password, it only ever logs in on tty1.
# Without that shell tty1 would log in and out until systemd gives up: rather no image.
[ -x /usr/local/sbin/home-ve-kiosk ] || { echo "home-ve hook: /usr/local/sbin/home-ve-kiosk is missing" >&2; exit 1; }
id kiosk >/dev/null 2>&1 || useradd --create-home --shell /usr/local/sbin/home-ve-kiosk --groups video,render,input kiosk
