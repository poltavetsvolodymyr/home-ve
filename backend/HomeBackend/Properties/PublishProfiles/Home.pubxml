<?xml version="1.0" encoding="utf-8"?>
<!--
  The build that runs on the host: one self-contained, trimmed linux-x64 executable (the .NET runtime is
  inside, nothing to install there), written straight into deploy/app.
    dotnet publish backend/HomeBackend -p:PublishProfile=Home
  build.ps1 / build.sh run this together with the frontend build.
-->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <RuntimeIdentifier>linux-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <PublishTrimmed>true</PublishTrimmed>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <PublishDir>$(MSBuildProjectDirectory)/../../deploy/app/</PublishDir>
  </PropertyGroup>
</Project>
