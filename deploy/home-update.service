# Updates the VM web UI: /opt/home-ve/deploy/update.sh (git pull, then install.sh) as root.
# The "Update" button on the Settings page starts it; polkit lets home-backend start this unit and nothing
# more (vm/50-home-backend.rules). A unit of its own, so the update outlives the backend, which install.sh restarts.
[Unit]
Description=Update the VM web UI (git pull + install.sh)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
# git and ssh (the deploy key in /root/.ssh) look for root's files here; services start without HOME
Environment=HOME=/root
ExecStart=/opt/home-ve/deploy/update.sh
TimeoutStartSec=15min
