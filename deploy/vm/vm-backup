#!/bin/bash
# vm-backup <name>: backs up a VM's disk into /var/backups/vm/<name>/ without stopping it, then thins out
# the old backups. vm-backup@<name>.service runs it as root (the web UI's "Back up now", the nightly timer).
#
#   1. if the VM runs and its guest agent is listening: freeze its file systems for a moment (fsfreeze),
#      so the copy is as clean as after a proper shutdown; without an agent it's like a power cut, still fine
#   2. a thin snapshot of the disk: instant, takes no space until the VM writes
#   3. thaw the guest, which goes on working while the snapshot is compressed (zstd) into the backup
#   4. remove the snapshot; keep the newest backup of each of the last 7 days and of 4 weeks before
#
# Files: <name>-<YYYYmmdd-HHMMSS>.img.zst (the disk), .conf (the VM's settings then), .info (the disk size).
set -eu

POOL=data
DIR=/var/backups/vm
KEEP_DAILY=7
KEEP_WEEKLY=4

die() {
  echo "vm-backup: $*" >&2
  exit 1
}

name=${1:-}
printf '%s\n' "$name" | grep -Eqx '[a-z][a-z0-9-]{0,11}' || die "bad VM name '$name'"
conf=/etc/vm/$name.conf
[ -f "$conf" ] || die "no $conf"
mountpoint -q "$DIR" || die "$DIR is not mounted: no backup into the root file system"
# a disk being restored is half old, half new: nothing worth keeping
if systemctl list-units --no-legend --state=activating "vm-restore@$name:*" | grep -q .; then
  die "a backup is being restored onto $name"
fi

# the disk, checked like vm-run does: a thin volume in the pool
disk=$(sed -n 's/^[[:space:]]*DISK=//p' "$conf" | tail -1)
printf '%s\n' "$disk" | grep -Eqx '/dev/[a-z0-9][a-z0-9_.-]*/[a-z0-9][a-z0-9_.-]*' || die "bad DISK '$disk' in $conf"
lv=${disk#/dev/}
# only the VM's own disk (<group>/<name>): a .conf pointing at another VM's disk would file a copy of
# that one under this VM's name, and a restore would then hand it over
[ "$lv" = "${lv%%/*}/$name" ] || die "$disk isn't named after the VM: back it up by hand"
[ "$(lvs --noheadings -o pool_lv -- "$lv" 2>/dev/null | tr -d ' ')" = "$POOL" ] || die "$lv is not a thin volume in the pool $POOL"

snap=${lv%%/*}/$name-backup
stamp=$(date +%Y%m%d-%H%M%S)
out=$DIR/$name
base=$out/$name-$stamp
frozen=no

# The guest agent (qemu-ga) is talked to over one connection for the whole backup, opened by qga_open and
# closed by qga_close only once every command has had its answer. Closing while an answer is on its way
# leaves qemu-ga unable to send it, and it then spins on a CPU of the guest until restarted.
pending=0 # commands sent, answers not read yet
reply=''  # the answer to the last qga command
qga_seq=0 # numbers the commands: the agent puts the number ("id") into its answer

# whether the guest has opened its end of the agent channel (QMP query-chardev: "frontend-open"), i.e. an
# agent is listening; without one nothing is sent, so nothing waits for answers that never come
qga_listening() {
  qmp "$name" query-chardev 2>/dev/null | grep -o '{[^{}]*"label": "qga"[^{}]*}' | grep -q '"frontend-open": true'
}

# socat in the background (coproc): QGA[1] writes to the agent, QGA[0] reads its answers
qga_open() {
  coproc QGA { exec socat - "UNIX-CONNECT:/run/vm-$name/qga.sock" 2>/dev/null; }
}

# qga <command>: sends it with the next id and puts the answer carrying that id into $reply, or leaves it
# empty after 30 s. Answers to earlier commands that come late are counted and skipped, so every command
# gets its own answer. read wakes up as soon as a line is there. Call it directly, not in a pipe or $(...):
# those run it in a subshell, which would lose count of the answers.
qga() {
  local id line left re
  reply=''
  [ -n "${QGA[1]:-}" ] || return 0 # not open, or socat is gone
  qga_seq=$((qga_seq + 1))
  id=$qga_seq
  re="\"id\": *${id}[^0-9]" # "id": 12 is not "id": 1
  # a socat that just died must not kill the script with SIGPIPE
  trap '' PIPE
  printf '{"execute":"%s","id":%d}\n' "$1" "$id" 1>&"${QGA[1]}" 2>/dev/null && pending=$((pending + 1))
  trap - PIPE
  local deadline=$((SECONDS + 30))
  while [ "$pending" -gt 0 ] && [ -n "${QGA[0]:-}" ]; do
    left=$((deadline - SECONDS))
    [ "$left" -gt 0 ] || break
    IFS= read -r -t "$left" line <&"${QGA[0]}" || break
    pending=$((pending - 1))
    if [[ $line =~ $re ]]; then
      reply=$line
      break
    fi
  done
}

# waits up to 2 minutes more for answers still owed, then closes (socat sees the end of its input)
qga_close() {
  [ -n "${QGA_PID:-}" ] || return 0
  while [ "$pending" -gt 0 ] && [ -n "${QGA[0]:-}" ] && IFS= read -r -t 120 _ <&"${QGA[0]}"; do
    pending=$((pending - 1))
  done
  if [ "$pending" -gt 0 ]; then echo "the guest agent still owes $pending answer(s): it may need a restart in the guest"; fi
  if [ -n "${QGA[1]:-}" ]; then eval "exec ${QGA[1]}>&-"; fi
  wait "$QGA_PID" 2>/dev/null || true
  QGA_PID=''
}

# whatever happens: thaw the guest, drop the snapshot, and no half backup left behind
cleanup() {
  if [ "$frozen" = yes ]; then qga guest-fsfreeze-thaw; fi
  qga_close
  lvremove -qy -- "$snap" >/dev/null 2>&1 || true
  rm -f -- "$base.img.zst.part"
  if [ ! -e "$base.img.zst" ]; then rm -f -- "$base.conf" "$base.info"; fi
}
trap cleanup EXIT
trap 'exit 1' INT TERM

# the directories: the web UI may list them (group home-backend), the files stay root's
install -d -m 0750 -g home-backend -- "$DIR" "$out"

lvremove -qy -- "$snap" >/dev/null 2>&1 || true # left over from an interrupted run
if systemctl is-active -q "vm@$name.service" && qga_listening; then
  qga_open
  frozen=yes # set before asking: should the answer be late, the thaw still goes out
  qga guest-fsfreeze-freeze
  if [[ $reply == *'"return"'* ]]; then
    echo "guest file systems frozen"
  else
    echo "the guest agent didn't confirm the freeze within 30 s: the copy may be like after a power cut"
  fi
else
  echo "no guest agent listening: the copy is like after a power cut"
fi
lvcreate -qq --snapshot --setactivationskip n --name "${snap#*/}" -- "$lv"
if [ "$frozen" = yes ]; then
  qga guest-fsfreeze-thaw
  frozen=no
fi
lvchange -qq -ay -K -- "$snap"

echo "compressing /dev/$lv into $base.img.zst"
umask 077
blockdev --getsize64 "/dev/$snap" | sed 's/^/SIZE=/' >"$base.info"
cp -- "$conf" "$base.conf"
zstd -q -T0 -3 <"/dev/$snap" >"$base.img.zst.part"
mv -- "$base.img.zst.part" "$base.img.zst"
echo "done: $(du -h "$base.img.zst" | cut -f1)"

# retention: the newest backup of each of the last $KEEP_DAILY days, then of $KEEP_WEEKLY more weeks
days='' weeks='' nd=0 nw=0
for f in $(find "$out" -maxdepth 1 -name "$name-*.img.zst" | sort -r); do
  stamp=${f##*/"$name"-}
  stamp=${stamp%.img.zst}
  day=${stamp%%-*}
  week=$(date -d "$day" +%G%V)
  if [ "$nd" -lt "$KEEP_DAILY" ] && ! echo "$days" | grep -qw "$day"; then
    days="$days $day" nd=$((nd + 1))
    echo "$weeks" | grep -qw "$week" || weeks="$weeks $week"
  elif [ "$nw" -lt "$KEEP_WEEKLY" ] && ! echo "$weeks" | grep -qw "$week"; then
    weeks="$weeks $week" nw=$((nw + 1))
  else
    echo "removing the old backup $stamp"
    rm -f -- "${f%.img.zst}.img.zst" "${f%.img.zst}.conf" "${f%.img.zst}.info"
  fi
done
